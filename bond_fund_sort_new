Option Explicit

Sub sort_column(column_name As String, order As Integer)
    
    'column_name should be a named range cell within the desired column
    'order should be 1 for ascending and 2 for descending
    
    Dim column As String
    column = Split(Cells(1, Range(column_name).column).Address, "$")(1)
    Worksheets("Super Matrix Portfolio-CIQ").Range("A4:AP" & 1048576).Sort key1:=Range(column & "4:" & column & 1048576), Header:=xlYes, order1:=order

End Sub

