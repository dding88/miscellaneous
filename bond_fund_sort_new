Sub set_all_buttons_correct_state(aCaption As String)
    Dim btnNames As Variant, btnCaptions As Variant, sheetColNames As Variant
    Dim i As Long, idx As Long
    Dim baseCaption As String, lastChar As String
    Dim colName As String
    Dim ws As Worksheet
    
    Set ws = Worksheets("Super Matrix Portfolio-CIQ")
    sheet_protection ws, False
    
    btnNames = Array("md_button", "mv_button", "identifier_button", "issuer_button", "final_rating_with_maturity_button")
    btnCaptions = Array("Maturity Date*", "Market Value*", "Identifier*", "Issuer", "Final Rating w/ Maturity")
    sheetColNames = Array("maturity_date", "market_value", "identifier", "issuer", "main_final_rating_api_column")
    
    lastChar = Right$(aCaption, 1)
    If lastChar = "^" Or lastChar = "v" Then
        baseCaption = Left$(aCaption, Len(aCaption) - 2)
    Else
        baseCaption = aCaption
    End If

    For i = LBound(btnCaptions) To UBound(btnCaptions)
        If StrComp(CStr(btnCaptions(i)), baseCaption, vbTextCompare) = 0 Then
            idx = i: Exit For
        End If
    Next i
    
    colName = CStr(sheetColNames(idx))
    Select Case lastChar
        Case "^"
           ws.Buttons(btnNames(idx)).Caption = baseCaption & " v"
            sort_column colName, 2
            
        Case "v"
            ws.Buttons(btnNames(idx)).Caption = baseCaption & " ^"
            sort_column colName, 1
            
        Case Else
            For i = LBound(btnNames) To UBound(btnNames)
                ws.Buttons(btnNames(i)).Caption = IIf(i = idx, btnCaptions(i) & " ^", btnCaptions(i))
            Next i
            sort_column colName, 1
        
        
        End Select

    sheet_protection ws, True
    
End Sub


